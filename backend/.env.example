# Copy this file to .env and fill values before running the backend.
# Replace <username>, <password>, <cluster-url>, and <dbname> with your Atlas values.
# If your password contains special characters, URL-encode it first.
# Example:
# MONGO_URL=mongodb+srv://<username>:<password>@<cluster-url>/<dbname>?retryWrites=true&w=majority&appName=stockmkt

MONGO_URL=
PORT=3002
